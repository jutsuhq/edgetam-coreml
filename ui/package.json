{
  "name": "edgetam-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Local GUI for tracking objects with the EdgeTAM Core ML packages",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "ETAM_OPEN=1 node server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
